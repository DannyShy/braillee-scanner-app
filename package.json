{
  "private": true,
  "name": "dotsight",
  "homepage": "https://dotsight.hotovo.com",
  "description": "Application for converting documents to braille",
  "version": "0.2.5",
  "author": "Hotovo s.r.o",
  "main": "app/background.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "build:mac": "nextron build --mac",
    "build:mac:universal": "nextron build --mac --universal",
    "build:linux": "nextron build --linux",
    "build:win32": "nextron build --win --ia32",
    "build:win64": "nextron build --win --x64",
    "postinstall": "electron-builder install-app-deps",
    "install32": "electron-builder install-app-deps --arch=ia32",
    "package": "ts-node scripts/package.mjs",
    "release": "ts-node scripts/release.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@mantine/core": "^7.1.5",
    "@mantine/hooks": "^7.1.5",
    "@mantine/styles": "^6.0.21",
    "@tabler/icons-react": "^2.38.0",
    "@types/bindings": "^1.5.1",
    "axios": "^1.5.1",
    "check-disk-space": "^3.4.0",
    "electron-is-dev": "^2.0.0",
    "electron-serve": "^1.2.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "file-selector": "^0.6.0",
    "fs-finder": "^1.8.1",
    "handlebars": "^4.7.8",
    "i18next": "^23.7.16",
    "i18next-fetch-backend": "^5.0.2",
    "liblouis": "^0.4.0",
    "liblouis-build": "^3.2.0-rc",
    "mupdf": "^1.27.0",
    "python-shell": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.1.0",
    "sass": "^1.80.7",
    "tmp": "^0.2.1",
    "tree-kill": "^1.2.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "^3.691.0",
    "@electron/notarize": "^2.5.0",
    "@types/react": "18.0.21",
    "@types/tmp": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-electron": "^7.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "next": "^13.5.5",
    "nextron": "^8.12.0",
    "node-gyp": "^12.2.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.31",
    "postcss-preset-mantine": "^1.9.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.hotovo.dotsight",
    "productName": "DotSight",
    "copyright": "Copyright © 2023 Hotovo",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "package.json",
          "app"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "./node_modules/mupdf",
        "to": "node_modules/mupdf",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./resources/AngelinaReader",
        "to": "AngelinaReader",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./resources/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./resources/liblouis-python",
        "to": "liblouis-python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "s3",
      "region": "eu-central-1",
      "bucket": "com.dotsight.prod.app.distribution",
      "channel": "latest"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icons/icon.png",
      "extraResources": [
        {
          "from": "./resources/os/darwin",
          "to": "os/darwin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage"
      ],
      "maintainer": "Hotovo <dotsight@hotovo.com>",
      "synopsis": "Braille Document Scanner and Recognizer",
      "executableName": "dotsight",
      "desktop": {
        "Name": "DotSight",
        "Comment": "Braille Document Scanner and Recognizer",
        "Terminal": "false",
        "Type": "Application",
        "Categories": "Office;",
        "StartupWMClass": "dotsight"
      },
      "extraResources": [
        {
          "from": "./resources/os/linux",
          "to": "os/linux",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.png",
      "publisherName": "Hotovo",
      "legalTrademarks": "s.r.o.",
      "extraResources": [
        {
          "from": "./resources/os/win32",
          "to": "os/win32",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always"
    }
  }
}
